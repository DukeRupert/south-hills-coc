{
    admin off
    auto_https off
}

:{$PORT:80} {
    # Proxy API requests to Go backend
    handle /api/* {
        reverse_proxy localhost:8080
    }

    # Serve static files for everything else
    handle {
        root * /srv
        try_files {path} {path}/ /index.html
        file_server
    }

    # Cache static assets: images, fingerprinted CSS/JS, fonts
    @static path /images/* /css/* /js/* *.woff2 *.woff
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Cache favicons and icons (change less often but still long-lived)
    @icons path /favicon.ico /apple-touch-icon.png
    header @icons Cache-Control "public, max-age=2592000"

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    encode gzip zstd

    log {
        output stdout
        format console
    }
}
