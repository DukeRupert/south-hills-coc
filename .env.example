# Docker Configuration
DOCKER_IMAGE=username/south-hills-coc:latest
LISTEN_PORT=8082

# Email Configuration (Postmark)
POSTMARK_TOKEN=your-postmark-server-token
FROM_EMAIL=noreply@southhillscoc.org
TO_EMAIL=office@southhillscoc.org

# CORS
ALLOWED_ORIGIN=https://www.southhillscoc.org

# Cloudflare Turnstile
# Production keys from Cloudflare dashboard
TURNSTILE_SECRET=your-turnstile-secret-key

# Test keys for local development:
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
