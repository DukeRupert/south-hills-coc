# Docker Configuration
DOCKER_IMAGE=username/south-hills-coc:latest
LISTEN_PORT=8082

# Email Configuration (Postmark)
POSTMARK_TOKEN=your-postmark-server-token
FROM_EMAIL=noreply@southhillscoc.org
TO_EMAIL=office@southhillscoc.org
ADMIN_EMAIL=office@southhillscoc.org

# CORS
ALLOWED_ORIGIN=https://www.southhillscoc.org

# Cloudflare Turnstile
# Production keys from Cloudflare dashboard
TURNSTILE_SECRET=your-turnstile-secret-key
TURNSTILE_SITE_KEY=your-turnstile-site-key

# Test keys for local development:
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Google Calendar iCal Feed
# Find in Google Calendar: Settings → [Calendar] → Integrate → Secret address in iCal format
# Note: @ in the calendar ID must be percent-encoded as %40
ICAL_FEED_URL=https://calendar.google.com/calendar/ical/xxx%40group.calendar.google.com/public/basic.ics

# Newsletter
# Absolute base URL, no trailing slash. Every link placed in an email is built
# from this, so a wrong value produces unclickable confirmation links.
SITE_BASE_URL=https://www.southhillscoc.org

# Postmark. The broadcast stream must be created in Postmark before first use;
# newsletters go on it so they never share reputation with transactional mail.
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_STREAM_TRANSACTIONAL=outbound
POSTMARK_STREAM_BROADCAST=broadcast
NEWSLETTER_FROM_NAME=South Hills Church of Christ
NEWSLETTER_FROM_ADDRESS=newsletter@southhillscoc.org

# Signing key for the hidden timestamp on the signup form. Generate with:
#   openssl rand -hex 32
# If unset, an ephemeral key is used and open forms stop validating on restart.
FORM_HMAC_SECRET=

# Reverse proxies in front of the app, used to pick the real client IP out of
# X-Forwarded-For for rate limiting. This deployment is Cloudflare + Caddy = 2.
# Set it too low and every visitor shares one bucket keyed on a Cloudflare edge
# IP; set it too high and a client can forge its own address.
TRUSTED_PROXY_COUNT=2
